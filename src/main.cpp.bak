
#include <iostream>
#include <chrono>
#include <thread>
#include "init.h"
#include "economy.h"
#include "gov.h"
#include "sim.h"
#include "industry.h"
#include "invest.h"

int main() {
    Init init;
    Economy econ;
    Government gov(init, econ);
    Industries ind(econ, gov);
    Investor inv(econ, gov, ind);
    Simulation sim(econ, gov, ind, inv);

    int years = 50;
    std::cout << "Year 0\n";
    econ.stats();
    gov.govStats();
    std::cout << "\nRunning simulation...\n";
    sim.run();
    std::cout << "Year 50\n";
    econ.stats();
    gov.govStats();
    


    return 0;
}